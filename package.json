{
  "name": "digital-commons-bm25",
  "version": "1.0.0",
  "description": "デジタル・コモンズ BM25スコアリングエンジン",
  "type": "module",
  "scripts": {
    "start": "npx tsx server.ts",
    "dev": "npx tsx --watch server.ts",
    "typecheck": "tsc --noEmit",
    "acceptance:test": "vitest run tests --fileParallelism=false",
    "test": "vitest run tests server.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:demo": "tsx scripts/seed_demo.ts",
    "export:json": "tsx scripts/export_json.ts",
    "export:sqlite": "tsx scripts/export_sqlite.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:migrate": "tsx scripts/migrate_db.ts",
    "migrate:kj-groups": "tsx scripts/migrate_kj_groups_json_to_sqlite.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "migrate:tokens": "tsx scripts/regenerate_card_tokens.ts",
    "backfill:tokens": "tsx scripts/backfill_card_tokens.ts",
    "backfill:article-tokens": "tsx scripts/backfill_article_tokens.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "kuromoji": "^0.1.2",
    "node-cron": "^4.5.0",
    "rss-parser": "^3.13.0",
    "tsx": "^4.22.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
