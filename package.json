{
  "name": "my-search-app",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Local-first knowledge management app with BM25 search and SQLite persistence",
  "type": "module",
  "scripts": {
    "start": "npx tsx server.ts",
    "dev": "npx tsx --watch server.ts",
    "typecheck": "tsc --noEmit",
    "acceptance:test": "vitest run tests --fileParallelism=false",
    "test": "vitest run server.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:demo": "tsx scripts/seed_demo.ts",
    "demo": "npm run seed:demo && npm start",
    "export:json": "tsx scripts/export_json.ts",
    "export:sqlite": "tsx scripts/export_sqlite.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:migrate": "tsx scripts/migrate_db.ts",
    "migrate:kj-groups": "tsx scripts/migrate_kj_groups_json_to_sqlite.ts",
    "migrate:articles": "tsx scripts/migrate_articles_json_to_sqlite.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:http": "tsx scripts/benchmark_http.ts",
    "backfill:card-tokens": "tsx scripts/backfill_card_tokens.ts",
    "backfill:article-tokens": "tsx scripts/backfill_article_tokens.ts",
    "git:safe-push": "powershell -ExecutionPolicy Bypass -File scripts/safe-push.ps1",
    "evaluate:search": "tsx scripts/evaluate_search_quality.ts",
    "check:encoding": "tsx scripts/check_encoding.ts",
    "verify:ci": "npm run typecheck && npm test && npm run acceptance:test && npm run benchmark:http && npm run evaluate:search && npm run check:encoding && npm audit --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run acceptance:test && npm run test:e2e && npm run benchmark && npm run benchmark:http && npm run evaluate:search && npm run check:encoding && npm audit --audit-level=high && docker build -t my-search-public:test ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "kuromoji": "^0.1.2",
    "node-cron": "^4.5.0",
    "pino": "^10.3.1",
    "rss-parser": "^3.13.0",
    "tsx": "^4.22.3",
    "vis-network": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
