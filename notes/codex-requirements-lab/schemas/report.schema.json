{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements Lab Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "input",
    "goals",
    "requirements",
    "hypotheses",
    "unknowns",
    "questions",
    "verification",
    "risks",
    "warnings"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^TC[0-9]{2}$"
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      },
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "hypothesis"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "kind",
        "source",
        "goal_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "proposed"
          ]
        },
        "kind": {
          "enum": [
            "business",
            "functional",
            "non_functional",
            "constraint"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "goal_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "impact",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "reason",
        "priority",
        "unknown_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "high",
            "medium"
          ]
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "method",
        "metric",
        "decision_rule",
        "limitation",
        "related_ids",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "related_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "planned",
            "completed"
          ]
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "mitigation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
